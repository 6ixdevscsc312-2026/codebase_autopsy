# ============================================
# CODEBASE AUTOPSY - ENVIRONMENT VARIABLES
# ============================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env (which is in .gitignore)
#    Command: cp .env.example .env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit the .env file to git
# 4. NEVER share your credentials in code or with AI assistants
#
# ============================================

# IBM Bob API Key (Inference-scoped)
# Get from: https://bob.ibm.com -> Organization -> API Keys
BOB_API_KEY=your_bob_inference_api_key_here_DO_NOT_COMMIT

# Set to 1 to run the pipeline against mock Bob responses instead of a
# live BOB_API_KEY / bob CLI install (useful for offline dev).
AUTOPSY_MOCK_BOB=0

# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit
# - Your actual .env file is in .gitignore
# - Never hardcode credentials in your code
# - Use os.environ.get("VARIABLE_NAME") to access values
# - Never share credentials with AI assistants like Bob
# ============================================
